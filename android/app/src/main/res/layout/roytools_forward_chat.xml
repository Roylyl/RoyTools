<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/chat_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/roytools_page_margin" android:background="?attr/glassCanvasStart">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical">
<ImageButton android:id="@+id/chat_back" android:layout_width="@dimen/roytools_touch_target" android:layout_height="@dimen/roytools_touch_target" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/roytools_back" android:contentDescription="返回" app:tint="?attr/colorPrimary" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/roytools_chat_title" android:textAppearance="@style/TextAppearance.ClashGlass.Title" />
</LinearLayout>
<TextView android:id="@+id/chat_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="连接失败" android:visibility="gone" android:textColor="?attr/colorError" />
<ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:id="@+id/chat_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</ScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:paddingTop="8dp" android:paddingBottom="4dp">
<ImageButton android:id="@+id/chat_add" android:layout_width="@dimen/roytools_touch_target" android:layout_height="@dimen/roytools_touch_target" android:layout_marginEnd="8dp" android:src="@drawable/chat_plus" android:contentDescription="添加附件" android:background="@android:color/transparent" app:tint="?attr/colorOnPrimary" />
<LinearLayout android:id="@+id/chat_composer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="bottom" android:padding="5dp">
<EditText android:id="@+id/chat_input" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:gravity="center_vertical" android:background="@android:color/transparent" android:hint="信息" android:textSize="16sp" android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/glassTextSecondary" android:inputType="textMultiLine|textCapSentences" android:maxLength="3900" android:maxLines="5" />
<ImageButton android:id="@+id/chat_send" android:layout_width="@dimen/roytools_touch_target" android:layout_height="@dimen/roytools_touch_target" android:padding="12dp" android:src="@drawable/chat_send" android:contentDescription="发送" android:background="@android:color/transparent" app:tint="?attr/colorOnPrimary" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
