<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/glassCanvasStart"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/roytools_page_margin"
            android:paddingVertical="8dp">

            <LinearLayout style="@style/RoyTools.Card">
                <TextView style="@style/RoyTools.ProxySectionHeading" android:text="代理状态" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RoyTools.ProxyLabel" android:text="VPN开关" />
                        <TextView
                            android:id="@+id/proxy_status"
                            style="@style/RoyTools.Caption"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="?attr/colorPrimary"
                            android:text="未连接" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/proxy_enabled"
                        style="@style/RoyTools.SettingSwitch"
                        android:contentDescription="VPN开关"
                        android:enabled="false" />
                </LinearLayout>
                <View style="@style/RoyTools.ProxyDivider" android:layout_marginVertical="10dp" />
                <LinearLayout
                    android:id="@+id/proxy_traffic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout style="@style/RoyTools.ProxyRateCell">
                        <TextView style="@style/RoyTools.Caption" android:text="↑上传速度" />
                        <TextView android:id="@+id/proxy_upload_speed" style="@style/RoyTools.ProxyRate" />
                    </LinearLayout>
                    <LinearLayout style="@style/RoyTools.ProxyRateCell">
                        <TextView style="@style/RoyTools.Caption" android:text="↓下载速度" />
                        <TextView android:id="@+id/proxy_download_speed" style="@style/RoyTools.ProxyRate" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/proxy_session_traffic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/proxy_profile_hint"
                    style="@style/RoyTools.Caption"
                    android:layout_marginTop="12dp"
                    android:text="导入订阅或配置文件后即可开启VPN。"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/proxy_issue"
                    style="@style/RoyTools.Caption"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout style="@style/RoyTools.Card">
                <TextView style="@style/RoyTools.ProxySectionHeading" android:text="代理模式" />
                <LinearLayout
                    android:id="@+id/proxy_mode_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.github.kr328.clash.common.ui.FourStepSlider
                        android:id="@+id/proxy_mode_slider"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:contentDescription="代理模式，默认、规则、音乐、AI、全局、直连" />
                    <LinearLayout
                        android:id="@+id/proxy_mode_labels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/RoyTools.ProxyModeLabel" android:text="默认" />
                        <TextView style="@style/RoyTools.ProxyModeLabel" android:text="规则" />
                        <TextView style="@style/RoyTools.ProxyModeLabel" android:text="音乐" />
                        <TextView style="@style/RoyTools.ProxyModeLabel" android:text="AI" />
                        <TextView style="@style/RoyTools.ProxyModeLabel" android:text="全局" />
                        <TextView style="@style/RoyTools.ProxyModeLabel" android:text="直连" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/proxy_mode_menu"
                    style="@style/RoyTools.SecondaryButton"
                    android:layout_marginTop="0dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/proxy_mode_hint"
                    style="@style/RoyTools.Caption"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <LinearLayout style="@style/RoyTools.Card">
                <TextView style="@style/RoyTools.ProxySectionHeading" android:text="配置与连接" />
                <LinearLayout
                    android:id="@+id/proxy_connections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout style="@style/RoyTools.Card">
                <TextView style="@style/RoyTools.ProxySectionHeading" android:text="规则更新" />
                <LinearLayout
                    android:id="@+id/proxy_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/proxy_rule_message"
                        style="@style/RoyTools.Caption"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
