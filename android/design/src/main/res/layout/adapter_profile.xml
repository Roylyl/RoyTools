<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="profile" type="com.github.kr328.clash.service.model.Profile" />
        <variable name="source" type="String" />
        <variable name="clicked" type="android.view.View.OnClickListener" />
        <variable name="menu" type="android.view.View.OnClickListener" />
        <import type="android.view.View" />
    </data>
    <LinearLayout android:id="@+id/root_view"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/glass_page_margin" android:layout_marginVertical="4dp"
        android:background="@drawable/bg_glass_card" android:clipToOutline="true"
        android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="8dp"
        android:onClick="@{clicked}">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingVertical="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="2" android:text="@{profile.name}"
                android:textAppearance="@style/TextAppearance.ClashGlass.Body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@{source}"
                android:textAppearance="@style/TextAppearance.ClashGlass.Caption" />
        </LinearLayout>
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="3dp"
            android:src="@drawable/ic_outline_check_circle" android:tint="?attr/colorPrimary"
            android:importantForAccessibility="no"
            android:visibility="@{profile.active ? View.VISIBLE : View.INVISIBLE}" />
        <ImageView android:id="@+id/menu_view" android:contentDescription="@string/more"
            android:layout_width="@dimen/glass_touch_target" android:layout_height="@dimen/glass_touch_target"
            android:padding="12dp" android:src="@drawable/ic_baseline_more_vert"
            android:background="@drawable/bg_glass_clickable" android:clickable="true" android:focusable="true"
            android:onClick="@{menu}" />
    </LinearLayout>
</layout>
