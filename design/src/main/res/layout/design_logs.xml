<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="self" type="com.github.kr328.clash.design.LogsDesign" />
        <import type="com.github.kr328.clash.design.LogsDesign.Request" />
    </data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_glass_canvas" android:orientation="vertical" android:paddingStart="@{self.surface.insets.start}" android:paddingEnd="@{self.surface.insets.end}">

        <com.github.kr328.clash.design.view.ActivityBarLayout android:id="@+id/activity_bar_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@{self.surface.insets.top}">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <include layout="@layout/common_activity_bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@id/delete_view" />
                <com.google.android.material.button.MaterialButton style="@style/RoyTools.MaterialButton" android:id="@+id/delete_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginEnd="16dp" android:text="@string/roytools_logs_clear" android:onClick="@{() -&gt; self.requests.offer(Request.DeleteAll.INSTANCE)}" />
            </RelativeLayout>
        </com.github.kr328.clash.design.view.ActivityBarLayout>

        <LinearLayout style="@style/RoyTools.Card" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/RoyTools.CardTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/roytools_logs_live" />
                <TextView android:id="@+id/capture_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/roytools_logs_idle" android:textSize="13sp" android:textColor="?attr/glassTextSecondary" />
            </LinearLayout>
            <TextView android:id="@+id/capture_description" style="@style/RoyTools.Caption" android:layout_marginTop="10dp" android:text="@string/roytools_logs_intro" />
            <com.google.android.material.button.MaterialButton android:id="@+id/start_logcat" style="@style/RoyTools.PrimaryButton" android:text="@string/roytools_logs_start" android:onClick="@{() -&gt; self.requests.offer(Request.StartLogcat.INSTANCE)}" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="22dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/roytools_logs_history" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/history_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/glassTextSecondary" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/history_hint" style="@style/RoyTools.Caption" android:layout_marginHorizontal="22dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:text="@string/roytools_logs_history_hint" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingBottom="@{self.surface.insets.bottom}">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingHorizontal="16dp" android:paddingBottom="16dp" />
            <LinearLayout android:id="@+id/empty_view" style="@style/RoyTools.Card" android:layout_marginHorizontal="16dp" android:padding="28dp" android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/roytools_logs_history_empty" android:textSize="16sp" android:textColor="?attr/colorOnSurface" />
                <TextView style="@style/RoyTools.Caption" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/roytools_logs_history_empty_hint" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</layout>
