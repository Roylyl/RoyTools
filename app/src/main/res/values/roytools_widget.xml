<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="roytools_widget_description">查看代理节点与网络用量，控制音乐播放、代理模式和刷新率。</string>
    <string name="roytools_widget_node_placeholder">当前代理节点</string>
    <string name="roytools_widget_profile_placeholder">当前配置</string>
    <string name="roytools_widget_wifi">Wi-Fi</string>
    <string name="roytools_widget_mobile">移动数据</string>
    <string name="roytools_widget_usage_placeholder">0B</string>
    <string name="roytools_widget_mode_default">默认</string>
    <string name="roytools_widget_mode_rule">规则</string>
    <string name="roytools_widget_mode_global">全局</string>
    <string name="roytools_widget_mode_direct">直连</string>
    <string name="roytools_widget_toggle">切换代理</string>
    <string name="roytools_widget_music_placeholder">未在播放</string>
    <string name="roytools_widget_music_previous">上一首</string>
    <string name="roytools_widget_music_toggle">播放或暂停</string>
    <string name="roytools_widget_music_next">下一首</string>
    <string name="roytools_widget_proxy_label">代理</string>
    <string name="roytools_widget_refresh_label">刷新率</string>
    <string name="roytools_widget_refresh_off">关闭</string>
    <string name="roytools_widget_refresh_60">60Hz</string>
    <string name="roytools_widget_refresh_120">120Hz</string>
    <string name="roytools_widget_refresh_adaptive">自适应</string>

    <style name="RoyTools.Widget.UsageLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="RoyTools.Widget.UsageValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="RoyTools.Widget.Mode" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="RoyTools.Widget.SectionLabel" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="RoyTools.Widget.MediaButton" parent="">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/roytools_widget_media_button_light</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
